{
  "manifest_version": 3,
  "name": "Kirim ke Chopster",
  "version": "1.3.1",
  "description": "Kirim tautan video hanya ke Chopster by Aris v8.5.5 (build terbaru).",
  "permissions": [
    "activeTab",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kirim ke Chopster",
    "default_popup": "popup.html"
  }
}
